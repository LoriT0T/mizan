{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mizan Defer-on-Disagreement register entry",
  "description": "A contested matter the system surfaces with cited positions and NEVER adjudicates.",
  "type": "object",
  "required": ["id", "scope_status", "question_ar", "question_en", "positions", "routing_ar", "routing_en", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^D[1-9][0-9]*$" },
    "scope_status": { "type": "string", "enum": ["in-murabaha-scope", "out-of-murabaha-scope"] },
    "question_ar": { "type": "string", "minLength": 1 },
    "question_en": { "type": "string", "minLength": 1 },
    "positions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["authority", "position_ar", "position_en", "citation"], "additionalProperties": false,
        "properties": {
          "authority": { "type": "string", "minLength": 1 },
          "position_ar": { "type": "string", "minLength": 1 },
          "position_en": { "type": "string", "minLength": 1 },
          "citation": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "routing_ar": { "type": "string", "minLength": 1 },
    "routing_en": { "type": "string", "minLength": 1 },
    "related_rule": { "type": "string" },
    "provenance": {
      "type": "object", "required": ["input", "grounding_basis"], "additionalProperties": false,
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "grounding_basis": { "type": "string", "enum": ["grounded", "unverified"] }
      }
    }
  }
}
